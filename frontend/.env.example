# Copy to .env.local. Not committed.

# `mock` runs entirely in the browser with no backend — the default, and the
# rollback if a cutover misbehaves.
# `live` reads from the API; writes still run against the mock store until the
# write cutover.
NEXT_PUBLIC_API_MODE=mock

# Only read in live mode.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
