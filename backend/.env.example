# Copy to backend/.env for local development. Never commit a real .env.
# All settings are read in app/core/config.py and nowhere else.

EXAM_ENVIRONMENT=development

# Port 5433 matches docker-compose: a college machine may already run Postgres
# on the default 5432.
EXAM_DATABASE_URL=postgresql+psycopg://exam:exam_local_dev@localhost:5433/exam_control

# The application refuses to start outside development while this is the
# placeholder value.
EXAM_JWT_SECRET=insecure-development-secret-change-me

# Long enough to outlast a three-hour paper plus overrun — being logged out
# mid-examination is not an acceptable failure mode.
EXAM_ACCESS_TOKEN_MINUTES=30
EXAM_REFRESH_TOKEN_HOURS=12

# Liveness thresholds, in seconds. A workstation turns 'warning' after missing
# a few beats and 'offline' once it has clearly gone away.
EXAM_HEARTBEAT_INTERVAL_SECONDS=10
EXAM_HEARTBEAT_WARNING_SECONDS=30
EXAM_HEARTBEAT_OFFLINE_SECONDS=90
