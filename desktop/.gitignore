# Rust build output. Large, machine-specific, and regenerated by `cargo build`.
src-tauri/target/

# Written by tauri-build on every compile from tauri.conf.json and the
# capability files. Committing it means every rebuild shows up as a diff.
src-tauri/gen/

# Platform icons produced by `cargo tauri icon src-tauri/icons/source.png`.
# The PNGs the Linux build needs are committed; these two are not, because
# they are only needed when bundling for Windows or macOS and are derived.
src-tauri/icons/icon.ico
src-tauri/icons/icon.icns
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png

# A workstation's own credential, if anyone ever points EXAM_LAB_CLIENT_HOME
# at the working tree while testing.
enrolment.json

# Cargo build output. The lockfile is committed; the artefacts are not.
target/
