{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exam Lab Client",
  "version": "0.1.0",
  "identifier": "edu.northbridge.examlabclient",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default", "exam-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "shortDescription": "Locked-down examination browser",
    "longDescription": "Runs on a laboratory workstation, enrols once against the examination server, and presents the candidate examination interface in a window the candidate cannot leave unaided."
  }
}
